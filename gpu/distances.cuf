! ==============================================================================
! MODULE: mod_distances (GPU / CUDA Fortran)
! ==============================================================================
! DESCRIPTION:
!   CPU reference routines and massively parallel CUDA GPU kernels for computing
!   minimum pairwise distances between cluster centers with 3D periodic boundary
!   conditions (minimum image convention).
!
! AUTHORS:
!   Antonio Díaz Pozuelo   - adiaz@iqf.csic.es
!   Enrique Lomba          - enrique.lomba@csic.es
!   Instituto de Química Física Blas Cabrera (IQF-CSIC)
!
! DATE:
!   September 2026
! ==============================================================================
module mod_distances
    use, intrinsic :: iso_fortran_env, only: sp=>real32, dp=>real64
    use mod_common
    use cudafor
    implicit none
contains

! ==============================================================================
! SUBROUTINE: cpu_centers_min_distance
! ==============================================================================
! DESCRIPTION:
!   Sequential CPU reference routine that calculates the minimum squared distance
!   between any pair of cluster centers across all time steps, applying periodic
!   boundary conditions. Used for validation against the GPU kernel.
!
! ARGUMENTS:
!   None. Operates on global module variables from mod_common:
!     - time_steps: Number of snapshots
!     - host_configurations: Snapshot cluster center positions
!     - side, side_div_2: Simulation box length and half-length
!     - min_distance: Minimum squared distance output
!
! AUTHORS:
!   Antonio Díaz Pozuelo   - adiaz@iqf.csic.es
!   Enrique Lomba          - enrique.lomba@csic.es
!
! DATE:
!   September 2026
! ==============================================================================
    subroutine cpu_centers_min_distance()
        integer :: i, j, k, s
        real(sp) :: distance
        real(sp) :: distance_arr(n_dim)
        print *, 'Proccesing minimal distances...'
        do i = 1, time_steps
            do j = 1, host_configurations(i)%n_centers - 1
                do k = j + 1, host_configurations(i)%n_centers
                    do s = 1, n_dim
                        distance_arr(s) = host_configurations(i)%centers(s,j) - host_configurations(i)%centers(s,k)
                        if (distance_arr(s) > side_div_2(s)) distance_arr(s) = distance_arr(s) - side(s)
                        if (distance_arr(s) < -side_div_2(s)) distance_arr(s) = distance_arr(s) + side(s)
                        distance_arr(s) = distance_arr(s) * distance_arr(s)
                    end do
                    distance = sum(distance_arr)
                    if (distance < min_distance) min_distance = distance 
                end do
            end do
        end do
    end subroutine cpu_centers_min_distance

! ==============================================================================
! KERNEL (GLOBAL): gpu_centers_min_distance
! ==============================================================================
! DESCRIPTION:
!   CUDA Fortran global kernel executing parallel pairwise distance comparisons
!   across simulation snapshots. Each GPU thread is mapped to a distinct time step
!   (snapshot), concurrently processing all cluster center pairs within that frame
!   under 3D periodic boundary conditions (minimum image convention) and recording
!   the frame's minimum squared distance into device memory.
!
! ARGUMENTS:
!   time_steps (in, value) - Total number of time steps / frames
!   n_dim (in, value)      - Spatial dimensionality (3 for 3D space)
!
! METHOD:
!   1. Computes global thread index: thread_id = (blockidx%x - 1)*blockdim%x + threadidx%x.
!   2. Guards against out-of-bounds execution (thread_id <= time_steps).
!   3. Loops over all unique pairs (j < k) of cluster centers in snapshot thread_id.
!   4. Applies minimum image convention for periodic wrapping:
!        dx = x_j - x_k; if (dx > L/2) dx = dx - L; if (dx < -L/2) dx = dx + L.
!   5. Calculates squared separation and updates dev_distances(thread_id).
!
! AUTHORS:
!   Antonio Díaz Pozuelo   - adiaz@iqf.csic.es
!   Enrique Lomba          - enrique.lomba@csic.es
!
! DATE:
!   September 2026
! ==============================================================================
    attributes(global) &
    subroutine gpu_centers_min_distance(time_steps, n_dim)
        integer, value, intent(in) :: time_steps
        integer, value, intent(in) :: n_dim
        integer :: thread_id, j, k, s
        real(sp) :: distance
        real(sp) :: distance_arr(n_dim)
        thread_id = (blockidx%x - 1) * blockdim%x + threadidx%x
        if (thread_id <= time_steps) then
            do j = 1, dev_configurations(thread_id)%n_centers - 1
                do k = j + 1, dev_configurations(thread_id)%n_centers
                    do s = 1, n_dim
                        distance_arr(s) = dev_configurations(thread_id)%centers(s,j) &
                            - dev_configurations(thread_id)%centers(s,k)
                        if (distance_arr(s) > dev_side_div_2(s)) distance_arr(s) = distance_arr(s) - dev_side(s)
                        if (distance_arr(s) < -dev_side_div_2(s)) distance_arr(s) = distance_arr(s) + dev_side(s)
                        distance_arr(s) = distance_arr(s) * distance_arr(s)
                    end do
                    distance = sum(distance_arr)
                    if (distance < dev_distances(thread_id)) dev_distances(thread_id) = distance 
                end do
            end do
        end if
    end subroutine gpu_centers_min_distance
    
end module mod_distances
